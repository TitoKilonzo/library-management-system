            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@library.test\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"patronToken\", json.accessToken);"
                ]
              }
            }
          ]
        },
