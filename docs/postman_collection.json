{
  "info": {
    "name": "Library Management System API",
    "description": "Week 2 endpoints: auth, users/profile, genres CRUD and books CRUD with filtering, search and pagination.\n\nRun order: Auth > Login (seeded librarian) and Login (seeded patron) first, then the other folders top to bottom. Seed accounts use the password from SEED_PASSWORD (default `Password123!`).\n\nNote: login is rate-limited to 5 requests per minute per IP, so wait a minute before re-running the Auth folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (new patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Public registration always creates a PATRON. A `role` field in the body is stripped by ValidationPipe({ whitelist: true }).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reader{{$timestamp}}@example.com\",\n  \"name\": \"New Reader\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"newUserToken\", json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (seeded librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run this first: it stores the LIBRARIAN token used by the write requests. Rate-limited to 5 attempts per minute.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.test\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"librarianToken\", json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (seeded patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
