# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env.

# Hosted PostgreSQL connection string (Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign and verify JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# How long a token stays valid (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN="1d"

# Optional: password for the seeded librarian/patron accounts (dev only)
# SEED_PASSWORD="Password123!"
