// api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String // bcrypt hash, never the plain-text password
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
  reviews   Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  books Book[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  isbn            String   @unique
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  genreId         Int
  genre           Genre    @relation(fields: [genreId], references: [id])
  reviews         Review[]

  @@index([genreId])
}

// Stretch: Review links a User to a Book (many-to-many via an explicit join model with extra fields)
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1-5, validated in the service/DTO layer
  comment   String?
  createdAt DateTime @default(now())
  bookId    Int
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId]) // one review per user per book
}
